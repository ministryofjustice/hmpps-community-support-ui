{% extends "../partials/layout.njk" %}

{% set pageTitle = applicationName + " - Referral" %}
{% set mainClasses = "govuk-body" %}

{% block content %}
<h1 class="govuk-heading-l">{{ content.pageHeader }}</h1>
    <div class="govuk-width-container">
        <ul class="govuk-grid-row card-group">
            {% for tile in content.tiles %}
                <li class="govuk-grid-column-one-third card-group__item">
                    <div class="card card--clickable" data-test="{{ tile.dataTestId }}" data-testid="{{ tile.dataTestId }}" data-qa="{{ tile.dataTestId }}">
                        <h2 class="govuk-heading-m card__heading">
                            <a class="govuk-link card__link govuk-link--no-visited-state" href="{{ tile.href }}">{{ tile.heading }}</a>
                        </h2>
                        <p class="govuk-body card__description">{{ tile.description }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
