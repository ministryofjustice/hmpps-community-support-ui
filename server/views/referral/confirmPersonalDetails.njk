{% extends "../partials/layout.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Referral - Community Support" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
  <h1 class="govuk-heading-l">{{ content.heading }}</h1>
  <h2 class="govuk-heading-m">{{ content.subheading }}</h2>
  {{ govukSummaryList(content.personal) }}
  {{ govukSummaryList(content.equality) }}
  {{ govukSummaryList(content.contact) }}
  {{ govukSummaryList(content.referral) }}
  {{ govukWarningText(content.warning) }}
  <form method="post" novalidate action="{{content.postHref}}" >
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
  {{ govukButton(content.button) }}
  </form>
{% endblock %}
