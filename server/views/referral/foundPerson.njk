{% extends "../partials/layout.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = applicationName + " - Found a Person" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
  <h1 class="govuk-heading-l">{{content.staticContent.pageHeader}}</h1>
    {{ govukSummaryList(content.personSummary) }}
    {{ govukButton({
      text: content.staticContent.continueButtonText,
      href: content.staticContent.continueButtonLink
    }) }}
{% endblock %}
