{% extends "../partials/layout.njk" %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% set pageTitle = "Make a referral - [Service name]" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}

<div class="govuk-grid-row">
    <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
    {{ content.pageHeader }}
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    </h1>
    <h2 class="govuk-heading-l">{{ content.pageSubHeader }}</h2>
    <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ content.taskListItemsBySection.personalDetails.title }}</h2>
    {{ govukTaskList({
      items: content.taskListItemsBySection.personalDetails.tasks
    }) }}

    <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ content.taskListItemsBySection.referralInformation.title }}</h2>
    {{ govukTaskList({
      items: content.taskListItemsBySection.referralInformation.tasks
    }) }}

    <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ content.taskListItemsBySection.contactDetails.title }}</h2>
    {{ govukTaskList({
      items: content.taskListItemsBySection.contactDetails.tasks
    }) }}

    <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ content.taskListItemsBySection.checkAnswers.title }}</h2>
    {{ govukTaskList({
      items: content.taskListItemsBySection.checkAnswers.tasks
    }) }}
</div>
{% endblock %}
