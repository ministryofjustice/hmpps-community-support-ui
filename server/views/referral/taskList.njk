{% extends "../partials/layout.njk" %}

{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% set pageTitle = "Make a referral - [Service name]" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}

{% set personalDetails = content.taskListItemsBySection.personalDetails %}
{% set referralInformation = content.taskListItemsBySection.referralInformation %}
{% set contactDetails = content.taskListItemsBySection.contactDetails %}
{% set checkAnswers = content.taskListItemsBySection.checkAnswers %}

<div class="govuk-grid-row">
  <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
    {{ content.pageHeader }}
  </h1>
  <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
  <h2 class="govuk-heading-l">{{ content.pageSubHeader }}</h2>

  <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ personalDetails.title }}</h3>
  {{ govukTaskList(personalDetails.taskList) }}

  <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ referralInformation.title }}</h3>
  {{ govukTaskList(referralInformation.taskList) }}

  <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ contactDetails.title }}</h3>
  {{ govukTaskList(contactDetails.taskList) }}

  <h3 class="govuk-heading-m govuk-!-margin-top-8">{{ checkAnswers.title }}</h3>
  {{ govukTaskList(checkAnswers.taskList) }}
</div>
{% endblock %}
