{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "moj/components/alert/macro.njk" import mojAlert %}

{% set pageTitle = content.pageHeader + " – " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block contentColumnClass %}govuk-grid-column-full{% endblock %}

{% block contentBody %}
  <h1 class="govuk-heading-l">{{ content.pageHeader }}</h1>

  {{ govukInsetText(content.selectedNeedAndOutcomeInset) }}

  {% if content.alert %}
    {{ mojAlert({
      variant: content.alert.variant,
      title: content.alert.title,
      html: content.alert.html,
      dismissible: content.alert.dismissible,
      attributes: {
        "data-testid": "action-plan-activities-alert"
      }
    }) }}
  {% endif %}

  {{ govukTable(content.activitiesTable) }}

  <form method="post" action="{{ content.saveAndContinueLink }}">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    {{ govukRadios(content.addAnotherActivityRadio) }}
    {{ govukButton(content.saveAndContinueButton) }}
  </form>

{% endblock %}
