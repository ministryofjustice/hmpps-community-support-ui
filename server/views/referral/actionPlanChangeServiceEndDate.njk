{% extends "../partials/layout.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}

{% set pageTitle = content.pageTitle %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
  <h1 class="govuk-heading-xl">{{ content.pageHeader }}</h1>

  <form method="post">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">

    {{ govukDateInput(content.updateServiceEndDateDateInputArgs) }}

    {{ govukTextarea(content.changeServiceEndDateReasonTextBoxArgs) }}

    {{ govukButton(content.submitButton) }}
  </form>
{% endblock %}
