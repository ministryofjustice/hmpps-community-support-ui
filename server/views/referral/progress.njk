{% extends "../partials/layout.njk" %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "moj/components/sub-navigation/macro.njk" import mojSubNavigation %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageTitle = "Referral progress – " + applicationName %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
  {% if content.notificationBanner %}
    {{ govukNotificationBanner(content.notificationBanner) }}
  {% endif %}

  <h1 class="govuk-heading-l">{{ content.pageHeader }}</h1>

  {{ mojSubNavigation(content.navBar) }}

  <h2 class="govuk-heading-m">Referral progress</h2>
  <h3 class="govuk-heading-s">Initial contact session (ICS)</h3>

  {% if content.icsAppointmentTable and content.icsAppointmentTable.rows.length %}
    {{ govukTable(content.icsAppointmentTable) }}
    {% if content.icsAppointmentHistoryTable and content.icsAppointmentHistoryTable.rows.length %}
      {% set historyTable = govukTable(content.icsAppointmentHistoryTable) %}
      {{ govukDetails({
        summaryText: content.historySummary,
        html: historyTable,
        attributes: {"data-testid":"view-history-link"}
      }) }}
    {% endif %}
  {% else %}
    <p class="govuk-body">No appointments scheduled</p>
  {% endif %}
{% endblock %}
