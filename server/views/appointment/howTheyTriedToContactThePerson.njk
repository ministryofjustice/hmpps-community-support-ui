{% extends "../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = "Non-attendance details - ICS feedback - [service name]" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
<form method="post">
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <h1 class="govuk-heading-l">{{ content.pageHeading }}</h1>
  {{ govukTextarea(content.form.contactAttemptsTextarea) }}
  {{ govukTextarea(content.form.reasonsForNonAttendanceTextarea) }}
  {{ govukButton(content.form.button) }}
</form>
{% endblock %}
