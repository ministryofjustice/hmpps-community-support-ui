{% extends "../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = applicationName + " - Referral" %}
{% set mainClasses = "govuk-body" %}

{% block contentBody %}
<h1 class="govuk-heading-l">{{ content.pageHeader }}</h1>
    {% for feedbackSummary in content.feedbackSummarys %}
       <h2 class="govuk-heading-m">{{ feedbackSummary.summaryTitle }}</h2>
       {{ govukSummaryList(feedbackSummary) }}
    {% endfor %}

    <form method="post" action="{{ content.submitHref }}">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    {{ govukButton({
        text: content.submitButtonText,
        classes: "govuk-!-margin-top-6"
    }) }}
    </form>
</div>
</div>
{% endblock %}
