{% extends "../../partials/layout.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% set pageTitle = content.pageTitle + " - " + applicationName %}

{% block content %}
  <h1 class="govuk-heading-l">{{ content.pageHeader }}</h1>

  {{ govukSummaryList(content.appointmentSummary) }}

  <form method="post" action="{{ content.submitHref }}">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    {{ govukButton({
      text: content.submitButtonText,
      classes: "govuk-!-margin-top-6"
    }) }}
  </form>
{% endblock %}
