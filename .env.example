PORT=3000
HMPPS_AUTH_URL=http://localhost:8090/auth
TOKEN_VERIFICATION_API_URL=http://localhost:9091/verification
COMMUNITY_SUPPORT_API_URL=http://localhost:9091/community-support
# No wiremock stub exists for /verification - leave disabled or logins will fail closed.
TOKEN_VERIFICATION_ENABLED=false
REDIS_ENABLED=false
NODE_ENV=development
# These must match real oauth clients seeded in HMPPS Auth's auth-db (see docker-compose.yml).
AUTH_CODE_CLIENT_ID=hmpps-community-support-ui-1
AUTH_CODE_CLIENT_SECRET=clientsecret
CLIENT_CREDS_CLIENT_ID=hmpps-community-support-ipb-ui-client-1
CLIENT_CREDS_CLIENT_SECRET=clientsecret
ENVIRONMENT_NAME=dev
